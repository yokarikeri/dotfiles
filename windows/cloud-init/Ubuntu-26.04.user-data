#cloud-config
# Ubuntu-26.04.user-data: Systemd enabled environment with Docker CE.
# ref. https://documentation.ubuntu.com/wsl/latest/
# ref. https://docs.cloud-init.io/en/latest/reference/datasources/wsl.html

# Install
# wsl --install Ubuntu-26.04
# wsl --set-default Ubuntu-26.04

# Uninstall
# wsl --unregister Ubuntu-26.04

timezone: Asia/Tokyo
locale: ja_JP.UTF-8

users:
  - name: wsl-user
    gecos: WSL User
    # System Groups: https://wiki.debian.org/SystemGroups
    groups: [users, sudo, adm] # netdev, audio, plugdev
    shell: /usr/bin/zsh
    sudo: ALL=(ALL) NOPASSWD:ALL

ssh_deletekeys: true

apt:
  sources:
    git-core-ppa:
      source: "ppa:git-core/ppa"
    mise-ppa:
      source: "ppa:jdxcode/mise"

package_update: true
package_upgrade: true
package_reboot_if_required: true

# Default packages: https://releases.ubuntu.com/resolute/ubuntu-26.04-wsl-amd64.manifest
packages:
  # === Localization ===
  - language-pack-ja # Japanese language support (main)
  - manpages-ja # Japanese man pages (universe)
  - manpages-ja-dev # Japanese man pages for developers (universe)

  # === Shell ===
  - shellcheck # Shell script linter (universe)
  - shfmt # Shell script formatter (universe)
  - starship # Cross-shell prompt (universe)
  - tmux # Terminal multiplexer (main)
  - zsh # Z shell (main)

  # === System ===
  - btop # replaces top / htop (universe)
  - bubblewrap # Unprivileged sandboxing tool (main)
  - cloud-image-utils # Cloud image management utilities (main)
  - mise # dev tools, env vars, task runner (ppa)
  - ncdu # replaces du (universe)
  - pydf # replaces df (universe)

  # === Editors & Pagers ===
  - bat # replaces cat (universe)
  - hexyl # replaces hexdump (universe)
  - vim # replaces vi (main)

  # === Search & File Utilities ===
  - eza # replaces ls (universe)
  - fd-find # replaces find (universe)
  - fzf # fuzzy finder (universe)
  - ripgrep # replaces grep (universe)
  - tree # Directory listing program (universe)
  # - ugrep # replaces grep (universe/utils)

  # === Text & Data Processing ===
  - colordiff # replaces diff (universe)
  - crudini # INI file utility (universe)
  - csvkit # CSV file utility (universe)
  - gron # Make JSON greppable (universe)
  - highlight # Source code to formatted text converter (universe)
  - jc # JSON Convert (universe)
  - jq # JSON Query (main)
  - pandoc # General markup converter (universe)
  - xmlstarlet # XML toolkit (universe)
  - yamllint # YAML linter (universe)
  - yq # YAML processor (universe)
  # - dasel # Data-Selector for JSON/YAML/TOML/XML/CSV/etc (universe)
  # - miller # Data processing tool for CSV/JSON/etc (universe)
  # - visidata # Terminal spreadsheet multitasker (universe)
  # - xq # XML and HTML processor (universe)

  # === Encoding & Line Endings ===
  - nkf # Network Kanji Filter (universe)
  - uchardet # Encoding detector (main)
  # - dos2unix # DOS/Mac to UNIX format converter (universe)

  # === Archiving & Compression ===
  - 7zip # File archiver (universe)
  - libarchive-tools # bsdtar, bsdcpio and bsdcat (universe)
  - tar # GNU tar archiving utility (main)
  - unzip # De-archiver for .zip files (main)
  - zip # Archiver for .zip files (main)

  # === Network & Download ===
  - bind9-dnsutils # DNS utilities (main)
  - bind9-host # DNS lookup utility (main)
  - curl # Client URL (main)
  - netcat-openbsd # TCP/IP swiss army knife (main)
  - openssh-client # Secure shell client (main)
  - socat # SOcket CAT (main)
  - wget # retrieves files from the web (main)
  - whois # WHOIS client (main)
  # - httpie # API testing client (universe)
  # - s-nail # Mail client (universe)

  # === Version Control ===
  - git # Distributed version control system (ppa)
  - git-delta # Syntax-highlighting pager for git (universe)
  - git-flow # Git extensions for repo operations (universe)

  # === X11 ===
  - xclip # CLI interface to X selections (main)
  # - xsel # CLI program for accessing X clipboard (universe)

  # === Database Clients ===
  # - postgresql-client # PostgreSQL command-line client (main)
  # - pgcli # PostgreSQL client with autocompletion and syntax highlighting (universe)
  # - pspg # Pager for tabular query output (universe)
  # - mysql-client # MySQL command-line client (main)
  # - mariadb-client # MariaDB command-line client (main)
  # - mycli # MySQL/MariaDB client with autocompletion and syntax highlighting (universe)
  # - sqlite3 # SQLite command-line client (main)
  # - litecli # SQLite client with autocompletion and syntax highlighting (universe)

  # === Network Filesystems & File Transfer ===
  # - smbclient # SMB/CIFS client (main)
  # - nfs-common # NFS client utilities (main)
  # - rsync # Fast incremental file transfer (main)
  # - lftp # Sophisticated file transfer client, FTP/SFTP/HTTP/etc (main)
  # - rclone # Cloud storage sync tool, "rsync for cloud" (universe)

write_files:
  - path: /etc/wsl.conf
    permissions: "0644"
    content: |
      # ref. https://learn.microsoft.com/en-us/windows/wsl/wsl-config
      # ref. https://documentation.ubuntu.com/wsl/stable/reference/instance_configuration/

      [boot]
      systemd = true

      [interop]
      appendWindowsPath = false
      enabled = true

      [user]
      default = wsl-user

      [network]
      hostname = u26w
      #generateHosts = true
      #generateResolvConf = true

  # Alternative to clip.exe
  - path: /usr/local/bin/clip.exe
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/sh

      # @(#) clip.exe wrapper for WSL

      # Reasons to use xclip:
      # - Uses LF line endings.
      # - Can be used even when WSL interoperability is disabled.
      if [ -n "$DISPLAY" ] && which xclip >/dev/null 2>&1; then
        xclip -selection clipboard && exit 0
      fi

      # Windows clip.exe — search all mounted Windows drives
      # iconv -t utf16 produces UTF-16 with BOM; tail -c +3 strips it,
      # leaving raw UTF-16LE that clip.exe interprets correctly
      for _mnt_point in $(LANG=C df -T | awk '$2 == "9p" && $1 ~ /^[A-Z]:\\$/ {print $NF}'); do
        _clip_path="$_mnt_point/Windows/System32/clip.exe"
        if [ -x "$_clip_path" ]; then
          iconv -t utf16 | tail -c +3 | "$_clip_path" && exit 0
        fi
      done

      exit 1

runcmd:
  # Locale overrides on top of LANG=ja_JP.UTF-8:
  #   LC_MESSAGES=C.UTF-8 - keep error/log messages in English for easier troubleshooting
  #   LC_TIME=en_DK.UTF-8 - ISO 8601 date/time format (YYYY-MM-DD, 24h)
  #   LC_COLLATE=C.UTF-8  - byte-order collation for deterministic sort
  - locale-gen en_DK.UTF-8
  - localectl set-locale LANG=ja_JP.UTF-8 LC_MESSAGES=C.UTF-8 LC_COLLATE=C.UTF-8 LC_TIME=en_DK.UTF-8

  # Disable root login
  # https://documentation.ubuntu.com/wsl/stable/explanation/security-overview/#disable-root-login
  - sed -i 's/^root.*$/root:x:0:0:root:\/root:\/usr\/sbin\/nologin/' /etc/passwd

  # dotfiles
  # Fork this repo on GitHub and replace the URL below with your fork's URL.
  - sudo -u wsl-user git clone https://github.com/yokarikeri/dotfiles.git /home/wsl-user/.dotfiles
  # --ssh-key copies %USERPROFILE%\.ssh\id_ed25519{,.pub} to ~/.ssh when present on Windows.
  - sudo -u wsl-user sh /home/wsl-user/.dotfiles/install.sh -y --ssh-key id_ed25519

  # editor: Nano -> Vim
  - update-alternatives --set editor /usr/bin/vim.basic

  # Docker CE
  # https://docs.docker.com/engine/install/ubuntu/
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - |
    tee /etc/apt/sources.list.d/docker.sources <<EOF
    Types: deb
    URIs: https://download.docker.com/linux/ubuntu
    Suites: $(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
    Components: stable
    Architectures: $(dpkg --print-architecture)
    Signed-By: /etc/apt/keyrings/docker.asc
    EOF
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - usermod -aG docker wsl-user

  # Claude Code
  # https://code.claude.com/docs/en/quickstart
  #- sudo -u wsl-user bash -c "curl -fsSL https://claude.ai/install.sh | bash"

  # Codex CLI
  # https://learn.chatgpt.com/docs/codex/cli
  #- sudo -u wsl-user bash -c "curl -fsSL https://chatgpt.com/codex/install.sh | sh"

  # Antigravity CLI
  # https://antigravity.google/download?os=linux#antigravity-cli
  #- sudo -u wsl-user bash -c "curl -fsSL https://antigravity.google/cli/install.sh | bash"

  # GitHub Copilot CLI
  # https://github.com/features/copilot/cli
  #- sudo -u wsl-user bash -c "curl -fsSL https://gh.io/copilot-install | bash"
